---
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "/{{ r.from }}/index.html"
eleventyExcludeFromCollections: true
noindex: true
---
{% set to = pathPrefix + r.to.slice(1) %}<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Moved</title><meta name="robots" content="noindex"><meta http-equiv="refresh" content="0; url={{ to }}"><link rel="canonical" href="{{ site.url }}{{ r.to }}"><script>location.replace("{{ to }}");</script></head><body><p>This page has moved to <a href="{{ to }}">{{ site.url }}{{ r.to }}</a>.</p></body></html>
