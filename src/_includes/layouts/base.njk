<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {% set pageTitle = title or name %}
  <title>{% if pageTitle %}{{ pageTitle }} · {{ site.name }}{% else %}{{ site.name }} · {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or summary or site.description }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ 'article' if kind == 'labnote' or kind == 'news' else 'website' }}">
  <meta property="og:title" content="{% if pageTitle %}{{ pageTitle }} · {{ site.name }}{% else %}{{ site.name }} · {{ site.tagline }}{% endif %}">
  <meta property="og:description" content="{{ description or summary or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or image or photo or '/assets/img/og.jpg' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#0E1116">
  <link rel="icon" href="{{ '/assets/brand/mark.svg' | link }}" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} · Lab notes" href="{{ site.url }}/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Public+Sans:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | link }}">
  <script>document.documentElement.classList.replace('no-js','js');</script>
  {% if page.url == '/' %}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"Organization","name":"{{ site.name }}","url":"{{ site.url }}","email":"{{ site.email }}","description":"{{ site.description }}","foundingDate":"{{ site.founded }}","address":{"@type":"PostalAddress","streetAddress":"89 South St","addressLocality":"Boston","addressRegion":"MA","addressCountry":"US"},"logo":"{{ site.url }}/assets/brand/mark.svg"}
  </script>
  <script>
    // Netlify Identity invite/recovery links land on the site root; send them to the CMS.
    if (/(invite|recovery|confirmation|email_change)_token=/.test(location.hash)) { location.replace('/admin/' + location.hash); }
  </script>
  {% endif %}
</head>
<body class="{{ bodyClass }}" id="page-top">
  <a class="skip" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="{{ '/assets/js/main.js' | link }}" defer></script>
</body>
</html>
