---
layout: layouts/base.njk
---
<article class="project">
  <header class="page-head">
    <div class="wrap project-head{% if glyph %} project-head--glyph{% endif %}">
      {% if glyph %}<div class="project-head__glyph">{% include "partials/glyph.njk" %}</div>{% endif %}
      <div class="project-head__text">
        <a class="crumb" href="{{ sectionUrl | link }}">← Projects</a>
        <p class="eyebrow{% if status %} eyebrow--beacon{% endif %}">{{ kind or sector }}{% if not glyph %} · {{ client }}{% endif %}{% if status %} · {{ status }}{% endif %}</p>
        <h1>{{ name or title }}</h1>
        <p class="lede">{% if name %}{{ title }}{% else %}{{ summary }}{% endif %}</p>
        {% if services %}<div class="chips">{% for s in services %}<span class="chip">{{ s }}</span>{% endfor %}</div>{% endif %}
        {% if cta_label or app_url %}
        <div class="hero__actions">
          {% if app_url %}<a class="btn btn-primary" href="{{ app_url }}" target="_blank" rel="noopener">Open {{ app_label or (app_url | replace("https://", "") | replace("http://", "")) }} {% include "partials/arrow.njk" %}</a>{% endif %}
          {% if cta_label %}<a class="btn {% if app_url %}btn-ghost{% else %}btn-primary{% endif %}" href="{{ '/contact/' | link }}">{{ cta_label }}{% if not app_url %} {% include "partials/arrow.njk" %}{% endif %}</a>{% endif %}
          {% if video and video.id %}<a class="btn btn-ghost" href="https://www.youtube.com/watch?v={{ video.id }}" target="_blank" rel="noopener">Watch it work</a>{% endif %}
        </div>
        {% endif %}
      </div>
    </div>
  </header>
  <div class="wrap section section--tight project__grid">
    <div class="project__main">
      {% if image %}<figure class="project__cover"><img src="{{ image | link }}" alt="{{ image_alt or '' }}" loading="lazy"></figure>{% endif %}
      <div class="prose">{% if name %}<p class="project__summary">{{ summary }}</p>{% endif %}{{ content | safe }}</div>
      {% if video and video.id and not capabilities %}{% set v = video %}{% include "partials/video.njk" %}{% endif %}
      {% if link %}<p class="post__link"><a class="btn btn-ghost" href="{{ link }}" target="_blank" rel="noopener">{{ link_label or 'Learn more' }} {% include "partials/arrow.njk" %}</a></p>{% endif %}
    </div>
    <aside class="project__side">
      {% if audience %}<div class="callout"><p class="eyebrow">Built for</p><p>{{ audience }}</p></div>{% endif %}
      {% if facts %}<div class="callout callout--facts"><p class="eyebrow">At a glance</p><dl class="facts facts--tight">{% for f in facts %}<dt>{{ f.label }}</dt><dd>{{ f.value }}</dd>{% endfor %}</dl></div>{% endif %}
      {% if links %}<div class="callout"><p class="eyebrow">Elsewhere</p><ul class="plain-list">{% for l in links %}<li><a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a></li>{% endfor %}</ul></div>{% endif %}
      {% if outcome %}<div class="callout"><p class="eyebrow">Outcome</p><p>{{ outcome }}</p></div>{% endif %}
      {% if quote and quote.text %}
      <blockquote class="quote quote--side">
        <span class="quote__mark" aria-hidden="true">“</span>
        <p class="quote__text">{{ quote.text }}</p>
        <p class="quote__by"><b>{{ quote.name }}</b>{{ quote.role }}</p>
      </blockquote>
      {% endif %}
    </aside>
  </div>
  {% if stats %}
  <section class="section section--tight"><div class="wrap"><div class="stats stats--flush">
    {% for s in stats %}<div class="stat"><span class="stat__n"><span data-count="{{ s.value }}">{{ s.value }}</span>{{ s.suffix }}</span><span class="stat__l">{{ s.label }}</span></div>{% endfor %}
  </div></div></section>
  {% endif %}
  {% if screens %}
  <section class="section section--paper2" id="screens">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Inside {{ name or short_client or client }}</p><h2>What it looks like to use.</h2>{% if video and video.id %}<p class="lede">Frames from the walkthrough and screens from the running app. <a href="https://www.youtube.com/watch?v={{ video.id }}" target="_blank" rel="noopener">Watch the full demo on YouTube</a>.</p>{% endif %}</div>
      <div class="screens">
        {% for sc in screens %}
        <figure class="screen"><img src="{{ sc.image | link }}" alt="{{ sc.alt or sc.caption }}" loading="lazy"><figcaption>{{ sc.caption }}</figcaption></figure>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
  {% if how_it_works %}
  <section class="section">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">How it works</p><h2>{{ how_it_works_title or "The work behind every card." }}</h2></div>
      <ol class="pipeline">
        {% for st in how_it_works %}<li class="pipeline__step"><span class="pipeline__n">{{ loop.index }}</span><div><h3 class="pipeline__t">{{ st.title }}</h3><p>{{ st.text }}</p></div></li>{% endfor %}
      </ol>
    </div>
  </section>
  {% endif %}
  {% if capabilities %}
  <section class="section section--paper2">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">What it does</p><h2>{{ capabilities_title or "Everything it does, and nothing extra." }}</h2></div>
      <div class="cap-grid">
        {% for c in capabilities %}<div class="cap"><h3>{{ c.title }}</h3><p>{{ c.text }}</p></div>{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
  {% if principles %}
  <section class="section">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Design principles</p><h2>The rules it was built by.</h2></div>
      <div class="cap-grid cap-grid--3">
        {% for pr in principles %}<div class="cap cap--plain"><h3>{{ pr.title }}</h3><p>{{ pr.text }}</p></div>{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
  {% if challenges %}
  <section class="section section--paper2">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">The hard problems</p><h2>What it took, and how we solved it.</h2><p class="lede">The interesting engineering is invisible when it works. Open one.</p></div>
      <div class="layers">
        {% for ch in challenges %}
        <details class="layer"{% if loop.first %} open{% endif %}>
          <summary><span class="layer__kicker eyebrow">{{ ch.kicker }}</span><span class="layer__title">{{ ch.title }}</span><span class="layer__plus" aria-hidden="true"></span></summary>
          <div class="layer__body"><p>{{ ch.text }}</p></div>
        </details>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
  {% if standard_applied %}
  <section class="section">
    <div class="wrap applied">
      <div class="sec-head"><p class="eyebrow">{{ standard.name }}, applied</p><h2>How our values show up inside {{ short_client or client }}.</h2><p class="lede">Values are easy to print. Here is where they live in the product.</p></div>
      <div class="applied__list">
        {% for s in standard_applied %}
        <div class="applied__row" data-reveal>
          <span class="applied__pillar">{{ s.pillar }}</span>
          <p>{{ s.how }}</p>
        </div>
        {% endfor %}
      </div>
      <p><a class="link-arrow" href="{{ '/philosophy/' | link }}#standard">Read the whole standard</a></p>
    </div>
  </section>
  {% endif %}
  {% if video and video.id and capabilities %}
  <section class="section section--tight"><div class="wrap">{% set v = video %}{% include "partials/video.njk" %}</div></section>
  {% endif %}
  {% if licensing %}
  <section class="section section--shoal">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Licensing</p><h2>Three ways to bring {{ short_client or client }} to your community.</h2></div>
      <div class="cap-grid cap-grid--3">
        {% for l in licensing %}<div class="cap cap--plain"><h3>{{ l.title }}</h3><p>{{ l.text }}</p></div>{% endfor %}
      </div>
      <p class="mt"><a class="btn btn-primary" href="{{ '/contact/' | link }}">{{ cta_label or 'Talk to us' }} {% include "partials/arrow.njk" %}</a></p>
    </div>
  </section>
  {% endif %}
  <section class="section section--paper2">
    <div class="wrap">
      <div class="sec-head sec-head--row"><h2 class="h3">More projects</h2><a class="link-arrow" href="{{ sectionUrl | link }}">All projects</a></div>
      <div class="tiles">
        {% for w in collections.work | whereNot("url", page.url) | limit(3) %}{% set item = w %}{% include "partials/tile.njk" %}{% endfor %}
      </div>
    </div>
  </section>
  {% include "partials/cta.njk" %}
</article>
