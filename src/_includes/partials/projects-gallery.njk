<section class="section section--paper2" id="projects">
  <div class="wrap">
    <div class="sec-head sec-head--row">
      <div>
        <p class="eyebrow">{{ home.projects.eyebrow }}</p>
        <h2>{{ home.projects.headline }}</h2>
      </div>
      <a class="btn btn-ghost" href="{{ '/work/' | link }}">See all projects {% include "partials/arrow.njk" %}</a>
    </div>
  </div>
  <div class="slider slider--bleed" data-slider aria-roledescription="carousel" aria-label="Projects">
    <div class="slider__stage">
      <button class="slider__arrow slider__arrow--prev" type="button" data-slider-prev aria-label="Previous projects">{% set dir = 'left' %}{% include "partials/chevron.njk" %}</button>
      <ul class="slider__track" data-slider-track>
        {% for w in collections.work %}<li class="slider__slide">{% set item = w %}{% set tileCompact = true %}{% include "partials/tile.njk" %}</li>{% endfor %}
      </ul>
      <button class="slider__arrow slider__arrow--next" type="button" data-slider-next aria-label="More projects">{% set dir = 'right' %}{% include "partials/chevron.njk" %}</button>
    </div>
    <div class="wrap slider__controls">
      <span class="slider__meter" aria-hidden="true"><i data-slider-meter></i></span>
      <span class="slider__count" data-slider-count aria-live="polite">1–3 of {{ collections.work.length }}</span>
      <span class="slider__hint" aria-hidden="true">· Swipe or use the arrows</span>
    </div>
  </div>
</section>
