<section class="section vision-section" id="north-star">
  <div class="wrap vision{% if compact %} vision--compact{% endif %}">
    <div class="vision__head">
      <p class="eyebrow eyebrow--star">{{ vision.eyebrow }}</p>
      <h2>{{ vision.headline }}</h2>
      <blockquote class="pull">
        <p>{{ vision.pullquote }}</p>
        <cite>{{ vision.pullquote_by }}</cite>
      </blockquote>
    </div>
    <div class="vision__body prose prose--lg">
      {% if compact %}
      <p>{{ vision.home_summary }}</p>
      <p><a class="link-arrow" href="{{ '/philosophy/' | link }}#north-star">Read more</a></p>
      {% else %}
      {% for p in vision.paragraphs %}<p>{{ p }}</p>{% endfor %}
      <p class="vision__closing">{{ vision.closing }}</p>
      {% endif %}
    </div>
  </div>
</section>
