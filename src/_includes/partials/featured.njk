{% set fp = collections.work | bySlug(home.featured.project) %}
{% if fp %}
<section class="shelf" id="featured" aria-labelledby="featured-title">
  <div class="wrap">
    <div class="tray">
      <a class="tray__visual" href="{{ fp.url | link }}" tabindex="-1" aria-hidden="true">
        {% if fp.data.glyph == 'lookout' %}{% include "partials/mini-radar.njk" %}{% elif fp.data.glyph %}{% set glyph = fp.data.glyph %}{% include "partials/glyph.njk" %}{% elif fp.data.thumb or fp.data.image %}<img src="{{ (fp.data.thumb or fp.data.image) | link }}" alt="">{% endif %}
      </a>
      <div class="tray__text">
        <p class="eyebrow tray__eyebrow">{{ home.featured.eyebrow }}{% if fp.data.status %}<span class="tray__status">{{ fp.data.status }}</span>{% endif %}</p>
        <h2 class="tray__name" id="featured-title"><a href="{{ fp.url | link }}">{{ fp.data.name or fp.data.short_client or fp.data.client }}</a></h2>
        <p class="tray__line">{{ home.featured.line }}</p>
      </div>
      <div class="tray__actions">
        <a class="btn btn-primary btn-sm" href="{{ fp.url | link }}">{{ home.featured.primary_label }} {% include "partials/arrow.njk" %}</a>
        {% if fp.data.video and fp.data.video.id %}<a class="tray__video" href="https://www.youtube.com/watch?v={{ fp.data.video.id }}" target="_blank" rel="noopener"><svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true" focusable="false"><path d="M6 4v12l10-6z" fill="currentColor"/></svg>{{ home.featured.secondary_label }}</a>{% endif %}
      </div>
    </div>
  </div>
</section>
{% endif %}
