{% if icon == 'training' %}
<svg viewBox="0 0 96 64" aria-hidden="true" focusable="false" class="glyph glyph--wide">
  <rect x="6" y="6" width="84" height="30" rx="3" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <path d="M16 22 C 26 12, 34 30, 44 20 S 62 12, 72 22" fill="none" stroke="var(--beacon)" stroke-width="2.5" stroke-linecap="round"/>
  <circle cx="24" cy="48" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M14 62 C16 52 32 52 34 62" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <circle cx="48" cy="48" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M38 62 C40 52 56 52 58 62" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <circle cx="72" cy="48" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M62 62 C64 52 80 52 82 62" fill="none" stroke="currentColor" stroke-width="2.5"/>
</svg>
{% elif icon == 'assistance' %}
<svg viewBox="0 0 96 64" aria-hidden="true" focusable="false" class="glyph glyph--wide">
  <path d="M8 52 C 24 52, 22 18, 40 18 S 56 46, 72 46 S 84 22, 90 14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="1 6"/>
  <circle cx="8" cy="52" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <circle cx="40" cy="18" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <circle cx="72" cy="46" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <circle cx="90" cy="14" r="6" fill="var(--beacon)"/>
  <path d="M84 4 L 96 4 M 90 -2 L 90 10" stroke="var(--beacon)" stroke-width="0"/>
</svg>
{% else %}
<svg viewBox="0 0 96 64" aria-hidden="true" focusable="false" class="glyph glyph--wide">
  <path d="M6 20 L40 8 L40 15 L11 25 Z" fill="var(--beacon)" opacity=".18"/>
  <path d="M6 28 L44 22 L44 29 L9 34 Z" fill="var(--beacon)" opacity=".12"/>
  <path d="M40 30 L52 30 L55 58 L37 58 Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
  <rect x="39" y="19" width="14" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <circle cx="46" cy="24.5" r="2.5" fill="var(--beacon)"/>
  <path d="M36 19 L56 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M62 44 h26 M62 52 h20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity=".5"/>
  <path d="M8 62 C14 56 20 56 26 62 C32 68 38 68 44 62 C50 56 56 56 62 62 C68 68 74 68 80 62" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".6"/>
</svg>
{% endif %}
