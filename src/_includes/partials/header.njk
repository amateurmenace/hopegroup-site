<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="{{ '/' | link }}" aria-label="{{ site.name }}, home">
      {% include "partials/mark.njk" %}
      <span class="brand__name">{{ site.name }}</span>
      <span class="brand__sub">Ethical AI Lab · Boston</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {% for item in navigation.primary %}
        <a href="{{ item.url | link }}"{% if page.url | isCurrent(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
      <a class="btn btn-primary btn-sm" href="{{ navigation.cta.url | link }}">{{ navigation.cta.label }}</a>
    </nav>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="drawer">
      <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i></span><span class="nav-toggle__label">Menu</span>
    </button>
  </div>
</header>
<div class="drawer" id="drawer" hidden>
    <div class="wrap drawer__inner">
      <nav aria-label="Mobile">
        <ul class="drawer__list">
          {% for item in navigation.primary %}<li><a href="{{ item.url | link }}">{{ item.label }}</a></li>{% endfor %}
          <li><a href="{{ '/services/' | link }}">Training & technical assistance</a></li>
          <li><a href="{{ '/news/' | link }}">News</a></li>
          <li><a href="{{ '/press/' | link }}">Press</a></li>
          <li><a href="{{ '/contact/' | link }}">Contact</a></li>
        </ul>
      </nav>
      <a class="btn btn-primary" href="{{ navigation.cta.url | link }}">{{ navigation.cta.label }} {% include "partials/arrow.njk" %}</a>
      <p class="drawer__foot">{{ site.address }} · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>
</div>
