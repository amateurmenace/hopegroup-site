<section class="section notebook-section" id="notes">
  <div class="wrap notebook-wrap">
    <div class="notebook-head">
      <p class="eyebrow">{{ home.notes.eyebrow }}</p>
      <h2>{{ home.notes.headline }}</h2>
      <p class="notebook-head__sub">{{ home.notes.intro }}</p>
      <p class="notebook-head__links">
        <a class="link-arrow" href="{{ '/lab-notes/' | link }}">All lab notes</a>
        <a class="link-arrow link-arrow--quiet" href="{{ '/news/' | link }}">News</a>
        <a class="link-arrow link-arrow--quiet" href="{{ '/press/' | link }}">Press</a>
      </p>
    </div>
    <div class="notebook">
      <span class="notebook__holes" aria-hidden="true"><i></i><i></i><i></i></span>
      <ol class="notebook__entries">
        {% for p in collections.labnotes | limit(3) %}
        <li>
          <a class="nb-entry" href="{{ p.url | link }}">
            <time class="nb-entry__date" datetime="{{ p.date | isoDate }}">{{ p.date | readableDate("LLL d") }}</time>
            <span class="nb-entry__title">{{ p.data.title }}</span>
            <span class="nb-entry__meta">{{ p.data.author }} · {{ p.templateContent | readingTime }} min read</span>
          </a>
        </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>
