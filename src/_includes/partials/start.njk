<section class="start section--tight" id="start">
  <div class="wrap">
    <div class="start__head">
      <p class="eyebrow">{{ home.start.eyebrow }}</p>
      <h2>{{ home.start.headline }}</h2>
      <p class="lede">{{ home.start.intro }}</p>
    </div>
    <div class="start__grid">
      {% for path in home.start.paths %}
      <a class="start__card" href="{{ path.url | link }}">
        <span class="start__icon">{% set icon = path.icon %}{% include "partials/start-icon.njk" %}</span>
        <span class="eyebrow">{{ path.eyebrow }}</span>
        <span class="start__t">{{ path.title }}</span>
        <span class="link-arrow">{{ path.label }}</span>
      </a>
      {% endfor %}
      {% set latest = collections.labnotes | first %}
      {% if latest %}
      <a class="start__card start__card--note" href="{{ latest.url | link }}">
        <span class="start__note-head"><span class="eyebrow">Latest lab note</span><time class="start__note-date" datetime="{{ latest.date | isoDate }}">{{ latest.date | readableDate("LLL d, yyyy") }}</time></span>
        <span class="start__note-title">{{ latest.data.title }}</span>
        <span class="start__note-summary">{{ latest.data.summary | truncate(120) }}</span>
        <span class="start__note-meta">{{ latest.data.author }} · {{ latest.templateContent | readingTime }} min read</span>
        <span class="link-arrow">Read the note</span>
      </a>
      {% endif %}
    </div>
  </div>
</section>
