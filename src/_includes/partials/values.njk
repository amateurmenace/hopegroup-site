<section class="section{% if not compact %} section--paper2{% endif %}" id="values">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Our values</p>
      <h2>{{ values.headline }}</h2>
      <p class="lede">{% if compact and home.values_line %}{{ home.values_line }}{% else %}{{ values.intro }}{% endif %}</p>
      {% if not compact %}<p class="aside">{{ values.aside }}</p>{% endif %}
    </div>
    {% if compact %}
    <div class="values-block" data-values-block>
      <ul class="values-preview">
        {% for v in values.items %}
        <li><button class="mini-poster" type="button" data-open-value="{{ loop.index0 }}"><span class="mini-poster__word">{{ v.name }}</span><span class="mini-poster__line">{{ v.poster }}</span></button></li>
        {% endfor %}
      </ul>
      <details class="values-drawer" data-values-drawer>
        <summary class="values-drawer__toggle"><span class="when-closed">See each value in practice</span><span class="when-open">Fold the values away</span><svg class="values-drawer__chev" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="M5 7.5 10 12.5 15 7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
        <p class="aside">{{ values.aside }}</p>
        {% include "partials/posters.njk" %}
      </details>
    </div>
    {% else %}
    {% include "partials/posters.njk" %}
    <p class="values__closing prose prose--lg">{{ vision.closing }}</p>
    {% endif %}
  </div>
</section>
