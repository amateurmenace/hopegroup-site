<script>/* GitHub Pages can't enforce HTTPS until its certificate for www.hopegroup.ai is issued, so plain http:// visits (and the old github.io link, which forwards to http) are sent to https here. Remove once "Enforce HTTPS" is back on. */if(location.protocol==="http:"&&/(^|\.)hopegroup\.ai$/.test(location.hostname))location.replace("https://hopegroup.ai"+location.pathname+location.search+location.hash);</script>
