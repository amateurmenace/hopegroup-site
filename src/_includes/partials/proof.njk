<section class="proof" id="proof">
  <div class="wrap">
    <div class="proof__head">
      <p class="eyebrow eyebrow--night">{{ recognition.eyebrow }}</p>
      <h2>{{ recognition.headline }}</h2>
    </div>
    <div class="proof__stats">
      {% for s in recognition.stats %}
      <div class="proof__stat">
        <span class="proof__n">{{ s.value }}{% if s.suffix %}<em>{{ s.suffix }}</em>{% endif %}</span>
        <span class="proof__l">{{ s.label }}</span>
      </div>
      {% endfor %}
    </div>
    <p class="proof__row"><span class="visually-hidden">Certified and recognized by: </span>{% for b in recognition.badges %}<span class="proof__org" title="{{ b.title }}">{{ b.org }}</span>{% endfor %}</p>
  </div>
</section>
