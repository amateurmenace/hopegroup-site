<section class="proof" id="proof">
  <div class="wrap">
    <div class="proof__head">
      <p class="eyebrow eyebrow--night">{{ recognition.eyebrow }}</p>
      <h2>{{ recognition.headline }}</h2>
    </div>
    <div class="proof__stats">
      {% for s in recognition.stats %}
      <div class="proof__stat">
        <span class="proof__n"><span{% if not s.plain %} data-count="{{ s.value }}"{% endif %}>{{ s.value }}</span>{% if s.suffix %}<em>{{ s.suffix }}</em>{% endif %}</span>
        <span class="proof__l">{{ s.label }}</span>
      </div>
      {% endfor %}
    </div>
    <ul class="proof__creds">
      {% for b in recognition.badges %}<li><span class="proof__org">{{ b.org }}</span><span class="proof__cred">{{ b.title }}</span></li>{% endfor %}
    </ul>
  </div>
</section>
