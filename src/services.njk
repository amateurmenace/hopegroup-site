---
layout: layouts/base.njk
permalink: "/services{{ ext }}"
eleventyComputed:
  title: "{{ services.title }}"
  description: "{{ services.description }}"
---
<header class="page-head page-head--ways">
  <div class="wrap">
    <p class="eyebrow">{{ services.eyebrow }}</p>
    <h1>{{ services.headline }}</h1>
    <p class="lede">{{ services.intro }}</p>
    <nav class="ways" aria-label="Three ways to work with us">
      {% for s in services.sections %}
      <a class="start__card ways__card" href="#{{ s.id }}">
        <span class="start__icon">{% set icon = s.icon %}{% include "partials/start-icon.njk" %}</span>
        <span class="ways__text">
          <span class="eyebrow"><span class="ways__n">{{ "0" + loop.index if loop.index < 10 else loop.index }}</span> {{ s.eyebrow }}</span>
          <span class="start__t">{{ s.card_title }}</span>
          {% if s.card_text %}<span class="ways__sum">{{ s.card_text }}</span>{% endif %}
          <span class="link-arrow link-arrow--down">{{ s.card_label or ("Go to " + s.eyebrow) }}</span>
        </span>
      </a>
      {% endfor %}
    </nav>
  </div>
</header>

{% for s in services.sections %}
{% set n = loop.index %}{% set alt = loop.index is even %}
{% include "partials/service-section.njk" %}
{% endfor %}

<section class="section section--shoal" id="where-we-start">
  <div class="wrap">
    <div class="sec-head"><p class="eyebrow">{{ faq.eyebrow }}</p><h2>{{ faq.headline }}</h2><p class="lede">{{ faq.intro }}</p></div>
    <div class="hear">
      {% for f in faq.items %}
      <div class="hear__row">
        <p class="hear__q">“{{ f.q }}”</p>
        <p class="hear__a"><span class="eyebrow">What we do</span>{{ f.a }}</p>
      </div>
      {% endfor %}
    </div>
    {% if services.who and services.who.length %}
    <div class="who who--after">
      <p class="eyebrow">{{ services.who_title }}</p>
      <div class="chips">{% for w in services.who %}<span class="chip">{{ w }}</span>{% endfor %}</div>
    </div>
    {% endif %}
  </div>
</section>

<section class="section" id="funding">
  <div class="wrap two-col">
    <div class="sec-head"><p class="eyebrow">Funding available</p><h2>Massachusetts may help pay for it.</h2></div>
    <div class="prose">
      <p>{{ site.funding_note }}</p>
      <p>To apply, contact Commonwealth Corporation directly at <a href="mailto:{{ site.funding_contact }}">{{ site.funding_contact }}</a> or through their portal, and mention Equity Intelligence LLC as your training provider. We are happy to walk you through it.</p>
      <p><a href="#training">Back to training</a></p>
    </div>
  </div>
</section>
{% include "partials/cta.njk" %}
